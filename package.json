{
  "name": "dsh-mobile-ui",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web のスマホ・タブレット対応を改善するローカル client プラグイン（狭幅での drawer 化、キーボード重なり対策、iOS フォーカスズーム抑止、セーフエリア）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "devDependencies": {
    "@xterm/xterm": "6.0.0",
    "happy-dom": "^20.14.6"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
